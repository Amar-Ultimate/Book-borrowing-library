def borrow_book(ID):

    query = """
    SELECT * FROM books
    WHERE Quantity > 0
    """

    cursor.execute(query)

    data = cursor.fetchall()


    if len(data) == 0:

        messagebox.showinfo(
            "No Books",
            "There are currently no books available."
        )

        return


    def selected_book(book_data):

        actual_book = book_data[0]

        quantity = book_data[3]


        if already_borrowed(
            ID,
            actual_book
        ):

            messagebox.showwarning(
                "Already Borrowed",
                "You have already borrowed this book."
            )


        elif quantity == 0:

            messagebox.showinfo(
                "Unavailable",
                "Book not available currently."
            )


        else:

            file = open(
                "borrowed_books.csv",
                "a",
                newline=""
            )

            writer = csv.writer(file)

            writer.writerow(
                [ID, actual_book]
            )

            file.close()


            query = """
            UPDATE books
            SET Quantity = Quantity - 1
            WHERE Book_Name=%s
            """


            cursor.execute(
                query,
                (actual_book,)
            )


            mycon.commit()


            messagebox.showinfo(
                "Happy Reading!",
                "You successfully borrowed:\n\n"
                + actual_book
            )


    selection_window(
        "Select a Book to Borrow",
        data,
        selected_book,
        lambda x:
            f"{x[0]}   |   {x[1]}   |   {x[2]}   |   Available: {x[3]}"
    )


# ============================================================
# RETURN BOOK
# ============================================================

def return_book(ID):

    borrowed = []


    file = open(
        "borrowed_books.csv",
        "r",
        newline=""
    )


    reader = csv.reader(file)

    next(reader)


    for row in reader:

        if row[0] == str(ID):

            borrowed.append(
                row[1]
            )


    file.close()


    if len(borrowed) == 0:

        messagebox.showinfo(
            "No Books",
            "You have no borrowed books to return."
        )

        return


    def selected_book(book):

        actual_book = ""


        file = open(
            "borrowed_books.csv",
            "r",
            newline=""
        )


        reader = csv.reader(file)

        next(reader)


        for row in reader:

            if row[0] == str(ID):

                if row[1].lower() == book.lower():

                    actual_book = row[1]

                    break


        file.close()


        if actual_book == "":

            messagebox.showwarning(
                "Not Borrowed",
                "You have not borrowed this book."
            )


        else:

            file = open(
                "borrowed_books.csv",
                "r",
                newline=""
            )


            temp_file = open(
                "temp.csv",
                "w",
                newline=""
            )


            reader = csv.reader(file)

            writer = csv.writer(temp_file)


            for row in reader:

                if not (
                    len(row) > 1
                    and row[0] == str(ID)
                    and row[1].lower()
                    == actual_book.lower()
                ):

                    writer.writerow(row)


            file.close()

            temp_file.close()


            os.remove(
                "borrowed_books.csv"
            )


            os.rename(
                "temp.csv",
                "borrowed_books.csv"
            )


            query = """
            UPDATE books
            SET Quantity = Quantity + 1
            WHERE LOWER(Book_Name) = LOWER(%s)
            """


            cursor.execute(
                query,
                (actual_book,)
            )


            mycon.commit()


            messagebox.showinfo(
                "Book Returned",
                "Thank you for returning:\n\n"
                + actual_book
            )


    selection_window(
        "Select a Book to Return",
        borrowed,
        selected_book
    )


# ============================================================
# RECOMMENDATION
# ============================================================

def recommendation():

    query = """
    SELECT DISTINCT Genre
    FROM books
    WHERE Quantity > 0
    """


    cursor.execute(query)

    data = cursor.fetchall()


    genres = [
        row[0]
        for row in data
    ]


    if len(genres) == 0:

        messagebox.showinfo(
            "Recommendations",
            "There are no available genres currently."
        )

        return


    def selected_genre(genre):

        query = """
        SELECT Book_Name
        FROM books
        WHERE LOWER(Genre)=LOWER(%s)
        AND Quantity > 0
        """


        cursor.execute(
            query,
            (genre,)
        )


        data = cursor.fetchall()


        if len(data) > 0:

            recommendation = random.choice(
                data
            )


            messagebox.showinfo(
                "Your Recommendation",
                recommendation[0]
                + "\n\nwould suit you!"
            )


        else:

            messagebox.showinfo(
                "No Books",
                "There are no books of this genre available currently."
            )


    selection_window(
        "Choose a Genre",
        genres,
        selected_genre
    )


