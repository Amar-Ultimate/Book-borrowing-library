def check_user():

    window = tk.Toplevel(root)

    window.title("Member Login")

    window.geometry("500x380")

    window.configure(bg=BG)

    window.transient(root)

    window.grab_set()


    tk.Label(
        window,
        text="Member Login",
        font=("Georgia", 24, "bold"),
        bg=BG,
        fg=DARK
    ).pack(pady=25)


    tk.Label(
        window,
        text="Enter your name",
        font=NORMAL_FONT,
        bg=BG
    ).pack()


    name_entry = tk.Entry(
        window,
        font=("Arial", 14),
        width=30,
        bg=LIGHT
    )

    name_entry.pack(pady=8)


    tk.Label(
        window,
        text="Enter your library ID",
        font=NORMAL_FONT,
        bg=BG
    ).pack()


    id_entry = tk.Entry(
        window,
        font=("Arial", 14),
        width=30,
        bg=LIGHT
    )

    id_entry.pack(pady=8)


    result = {
        "ID": None
    }


    def login():

        try:

            name = name_entry.get().title().strip()

            ID = int(id_entry.get())

        except ValueError:

            messagebox.showerror(
                "Invalid ID",
                "Library ID must be a number.",
                parent=window
            )

            return


        query = """
        SELECT * FROM users
        WHERE Name=%s AND ID=%s
        """


        cursor.execute(
            query,
            (name, ID)
        )


        data = cursor.fetchone()


        if data is not None:

            result["ID"] = ID

            window.destroy()

        else:

            messagebox.showerror(
                "Login Failed",
                "Incorrect name or ID.",
                parent=window
            )


    tk.Button(
        window,
        text="Login",
        command=login,
        font=BUTTON_FONT,
        width=20,
        height=2,
        bg=ACCENT,
        fg="white",
        relief="flat",
        cursor="hand2"
    ).pack(pady=20)


    root.wait_window(window)


    return result["ID"]


