# ============================================================
# ADD BOOK
# ============================================================

def add_book():

    window = tk.Toplevel(root)

    window.title("Add Book")

    window.geometry("650x550")

    window.configure(bg=BG)

    window.transient(root)

    window.grab_set()


    tk.Label(
        window,
        text="Add a New Book",
        font=("Georgia", 25, "bold"),
        bg=BG,
        fg=DARK
    ).pack(pady=25)


    form = tk.Frame(
        window,
        bg=BG
    )

    form.pack()


    labels = [
        "Book Name",
        "Author",
        "Genre"
    ]


    entries = []


    for i, label in enumerate(labels):

        tk.Label(
            form,
            text=label,
            font=NORMAL_FONT,
            bg=BG
        ).grid(
            row=i,
            column=0,
            sticky="w",
            pady=12
        )


        entry = tk.Entry(
            form,
            font=("Arial", 14),
            width=35,
            bg=LIGHT
        )


        entry.grid(
            row=i,
            column=1,
            padx=15,
            pady=12
        )


        entries.append(entry)


    def add():

        name = entries[0].get().strip()

        author = entries[1].get().strip()

        genre = entries[2].get().strip()


        if (
            name == ""
            or author == ""
            or genre == ""
        ):

            messagebox.showwarning(
                "Missing Information",
                "Please fill in all fields.",
                parent=window
            )

            return


        # ----------------------------------------------------
        # CHECK IF BOOK ALREADY EXISTS
        # ----------------------------------------------------

        query = """
        SELECT * FROM books
        WHERE LOWER(Book_Name)=LOWER(%s)
        """


        cursor.execute(
            query,
            (name,)
        )


        data = cursor.fetchone()


        # ----------------------------------------------------
        # BOOK ALREADY EXISTS
        # Increase quantity instead of INSERT
        # ----------------------------------------------------

        if data is not None:

            query = """
            UPDATE books
            SET Quantity = Quantity + 1
            WHERE Book_Name=%s
            """


            cursor.execute(
                query,
                (data[0],)
            )


            mycon.commit()


            messagebox.showinfo(
                "Book Already Exists",
                "The library already has this book.\n\n"
                + data[0]
                + "\n\n"
                + "Quantity has been increased by 1.",
                parent=window
            )


            window.destroy()


        # ----------------------------------------------------
        # BOOK DOES NOT EXIST
        # Add normally
        # ----------------------------------------------------

        else:

            try:

                cursor.execute(
                    """
                    INSERT INTO books
                    VALUES(%s,%s,%s,%s)
                    """,
                    (
                        name,
                        author,
                        genre,
                        1
                    )
                )


                mycon.commit()


                messagebox.showinfo(
                    "Book Added",
                    name
                    + " has been added to the library.",
                    parent=window
                )


                window.destroy()


            except mysql.connector.Error as e:

                messagebox.showerror(
                    "Database Error",
                    "Could not add the book.\n\n"
                    + str(e),
                    parent=window
                )


    tk.Button(
        window,
        text="Add Book",
        command=add,
        font=BUTTON_FONT,
        width=25,
        height=2,
        bg=GREEN,
        fg="white",
        relief="flat",
        cursor="hand2"
    ).pack(pady=25)


# ============================================================
# DELETE BOOK
# ============================================================

def delete_book():

    query = """
    SELECT * FROM books
    """


    cursor.execute(query)

    data = cursor.fetchall()


    if len(data) == 0:

        messagebox.showinfo(
            "Delete Book",
            "There are no books in the library."
        )

        return


    def selected_book(book):

        name = book[0]

        author = book[1]


        answer = messagebox.askyesno(
            "Confirm Delete",
            "Remove this book?\n\n"
            + name
            + "\n"
            + "by "
            + author
        )


        if answer:

            cursor.execute(
                """
                DELETE FROM books
                WHERE Book_Name=%s
                AND Author=%s
                """,
                (
                    name,
                    author
                )
            )


            mycon.commit()


            messagebox.showinfo(
                "Book Removed",
                name
                + " has been removed from the library."
            )


    selection_window(
        "Select a Book to Remove",
        data,
        selected_book,
        lambda x:
            f"{x[0]}   |   {x[1]}   |   {x[2]}   |   Quantity: {x[3]}"
    )


