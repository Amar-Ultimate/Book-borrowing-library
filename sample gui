def selection_window(title, items, callback, display_function=None):

    window = tk.Toplevel(root)

    window.title(title)

    window.geometry("700x500")

    window.configure(bg=BG)

    window.transient(root)

    window.grab_set()


    tk.Label(
        window,
        text=title,
        font=("Georgia", 22, "bold"),
        bg=BG,
        fg=DARK
    ).pack(pady=20)


    frame = tk.Frame(
        window,
        bg=BG
    )

    frame.pack(
        fill="both",
        expand=True,
        padx=35,
        pady=10
    )


    scrollbar = tk.Scrollbar(frame)

    scrollbar.pack(
        side="right",
        fill="y"
    )


    listbox = tk.Listbox(
        frame,
        font=("Arial", 13),
        bg=LIGHT,
        fg=TEXT,
        selectbackground=ACCENT,
        selectforeground="white",
        activestyle="none",
        yscrollcommand=scrollbar.set
    )

    listbox.pack(
        side="left",
        fill="both",
        expand=True
    )


    scrollbar.config(
        command=listbox.yview
    )


    for item in items:

        if display_function:

            listbox.insert(
                tk.END,
                display_function(item)
            )

        else:

            listbox.insert(
                tk.END,
                item
            )


    def choose():

        selected = listbox.curselection()

        if not selected:

            messagebox.showwarning(
                "Selection Required",
                "Please select an option.",
                parent=window
            )

            return


        item = items[selected[0]]

        window.destroy()

        callback(item)


    tk.Button(
        window,
        text="Select",
        command=choose,
        font=BUTTON_FONT,
        width=20,
        height=2,
        bg=ACCENT,
        fg="white",
        relief="flat",
        cursor="hand2"
    ).pack(pady=20)


