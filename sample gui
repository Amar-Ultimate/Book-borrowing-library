def already_borrowed(ID, book):

    file = open(
        "borrowed_books.csv",
        "r",
        newline=""
    )

    reader = csv.reader(file)

    next(reader)

    for row in reader:

        if row[0] == str(ID):

            if row[1].lower() == book.lower():

                file.close()

                return True

    file.close()

    return False


