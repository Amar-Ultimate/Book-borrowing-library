def join_library():

    window = tk.Toplevel(root)

    window.title("Join the Library")

    window.geometry("550x350")

    window.configure(bg=BG)

    window.transient(root)

    window.grab_set()


    tk.Label(
        window,
        text="Join the Library",
        font=("Georgia", 25, "bold"),
        bg=BG,
        fg=DARK
    ).pack(pady=30)


    tk.Label(
        window,
        text="Enter your name",
        font=NORMAL_FONT,
        bg=BG
    ).pack()


    name_entry = tk.Entry(
        window,
        font=("Arial", 15),
        width=30,
        bg=LIGHT
    )


    name_entry.pack(pady=12)


    def join():

        global nID


        name = name_entry.get().title().strip()


        if name == "":

            messagebox.showwarning(
                "Missing Name",
                "Please enter your name.",
                parent=window
            )

            return


        query = """
        SELECT * FROM users
        WHERE Name=%s
        """


        cursor.execute(
            query,
            (name,)
        )


        data = cursor.fetchone()


        if data is not None:

            messagebox.showwarning(
                "Already a Member",
                "A member with this name already exists.",
                parent=window
            )


        else:

            cursor.execute(
                "SELECT MAX(ID) FROM users"
            )


            maximum = cursor.fetchone()[0]


            if maximum is None:

                nID = 1

            else:

                nID = maximum + 1


            query = """
            INSERT INTO users
            VALUES(%s,%s)
            """


            cursor.execute(
                query,
                (nID, name)
            )


            mycon.commit()


            messagebox.showinfo(
                "Welcome!",
                name
                + ", welcome to the library!\n\n"
                + "Your library ID is: "
                + str(nID),
                parent=window
            )


            window.destroy()


    tk.Button(
        window,
        text="Join Library",
        command=join,
        font=BUTTON_FONT,
        width=20,
        height=2,
        bg=ACCENT,
        fg="white",
        relief="flat",
        cursor="hand2"
    ).pack(pady=20)


