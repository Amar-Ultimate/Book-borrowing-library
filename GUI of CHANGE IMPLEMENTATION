        window, text="Donate a Book", font=("Georgia", 25, "bold"), bg=BG, fg=DARK
    ).pack(pady=20)
    tk.Label(
        window, text="Please enter the donation details below",
        font=SUBTITLE_FONT, bg=BG, fg=SECONDARY
    ).pack(pady=(0, 20))

    form = tk.Frame(window, bg=BG)
    form.pack()

    labels = ["Your Name", "Book Name", "Author", "Genre"]
    entries = []

    for i, label in enumerate(labels):
        tk.Label(form, text=label, font=NORMAL_FONT, bg=BG).grid(
            row=i, column=0, sticky="w", pady=10
        )
        entry = tk.Entry(form, font=("Arial", 14), width=35, bg=LIGHT)
        entry.grid(row=i, column=1, pady=10, padx=10)
