    tk.Label(
        window, text="Author and genre are only needed for a new book.",
        font=("Arial", 10), bg=BG, fg=SECONDARY
    ).pack(pady=10)

    def donate():
        name = entries[0].get().strip()
        donation = entries[1].get().title().strip()
        Author = entries[2].get().strip()
        Genre = entries[3].get().strip()

        if name == "" or donation == "":
            messagebox.showwarning(
                "Missing Information", "Please enter your name and the book name.",
                parent=window
            )
            return

        query = "SELECT * FROM books WHERE LOWER(Book_Name)=LOWER(%s)"
        cursor.execute(query, (donation,))
        data = cursor.fetchone()

        if data is not None:
            query = "UPDATE books SET Quantity = Quantity + 1 WHERE Book_Name=%s"
            cursor.execute(query, (data[0],))
