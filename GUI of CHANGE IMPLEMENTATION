def join_library():
    window = tk.Toplevel(root)
    window.title("Join the Library")
    window.geometry("550x350")
    window.configure(bg=BG)
    window.transient(root)
    window.grab_set()

    tk.Label(
        window, text="Join the Library", font=("Georgia", 25, "bold"), bg=BG, fg=DARK
    ).pack(pady=30)
    tk.Label(window, text="Enter your name", font=NORMAL_FONT, bg=BG).pack()
    name_entry = tk.Entry(window, font=("Arial", 15), width=30, bg=LIGHT)
    name_entry.pack(pady=12)

    def join():
        global nID
        name = name_entry.get().title().strip()

        if name == "":
            messagebox.showwarning("Missing Name", "Please enter your name.", parent=window)
            return

        cursor.execute("SELECT * FROM users WHERE Name=%s", (name,))
        data = cursor.fetchone()

        if data is not None:
            messagebox.showwarning(
                "Already a Member", "A member with this name already exists.", parent=window
            )
        else:
            # Use the highest existing ID so IDs do not repeat after restarting.
            cursor.execute("SELECT MAX(ID) FROM users")
            maximum = cursor.fetchone()[0]
            nID = 1 if maximum is None else maximum + 1

            cursor.execute("INSERT INTO users VALUES(%s,%s)", (nID, name))
            mycon.commit()

            messagebox.showinfo(
                "Welcome!", name + ", welcome to the library!\n\nYour library ID is: "
                + str(nID), parent=window
            )
            window.destroy()

    tk.Button(
        window, text="Join Library", command=join, font=BUTTON_FONT,
        width=20, height=2, bg=ACCENT, fg="white", relief="flat", cursor="hand2"
    ).pack(pady=20)


