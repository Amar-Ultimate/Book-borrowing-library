# RETURN BOOK
# ============================================================

def return_book(ID):
    borrowed = []

    file = open("borrowed_books.csv", "r", newline="")
    reader = csv.reader(file)
    next(reader, None)

    for row in reader:
        if len(row) > 1 and row[0] == str(ID):
            borrowed.append(row[1])

    file.close()

    if len(borrowed) == 0:
        messagebox.showinfo("No Books", "You have no borrowed books to return.")
        return

    def selected_book(book):
        actual_book = ""

        file = open("borrowed_books.csv", "r", newline="")
        reader = csv.reader(file)
        next(reader, None)

        for row in reader:
            if len(row) > 1 and row[0] == str(ID):
                if row[1].lower() == book.lower():
                    actual_book = row[1]
                    break
        file.close()

        if actual_book == "":
            messagebox.showwarning("Not Borrowed", "You have not borrowed this book.")
        else:
            file = open("borrowed_books.csv", "r", newline="")
            temp_file = open("temp.csv", "w", newline="")
            reader = csv.reader(file)
            writer = csv.writer(temp_file)

            for row in reader:
                if not (
                    len(row) > 1 and row[0] == str(ID)
                    and row[1].lower() == actual_book.lower()
                ):
                    writer.writerow(row)

            file.close()
            temp_file.close()
            os.remove("borrowed_books.csv")
            os.rename("temp.csv", "borrowed_books.csv")

            query = """
            UPDATE books
            SET Quantity = Quantity + 1
            WHERE LOWER(Book_Name) = LOWER(%s)
            """
            cursor.execute(query, (actual_book,))
            mycon.commit()

            messagebox.showinfo(
                "Book Returned", "Thank you for returning:\n\n" + actual_book
            )

    selection_window("Select a Book to Return", borrowed, selected_book)


