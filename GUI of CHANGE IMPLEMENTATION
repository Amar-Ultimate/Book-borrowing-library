def borrow_book(ID):
    cursor.execute("SELECT * FROM books WHERE Quantity > 0")
    data = cursor.fetchall()

    if len(data) == 0:
        messagebox.showinfo("No Books", "There are currently no books available.")
        return

    def selected_book(book_data):
        actual_book = book_data[0]
        quantity = book_data[3]

        if already_borrowed(ID, actual_book):
            messagebox.showwarning(
                "Already Borrowed", "You have already borrowed this book."
            )
            return
        elif quantity == 0:
            messagebox.showinfo("Unavailable", "Book not available currently.")
            return

        # The original source asks for both dates when borrowing.
        date_window = tk.Toplevel(root)
        date_window.title("Borrowing Dates")
        date_window.geometry("560x380")
        date_window.configure(bg=BG)
        date_window.transient(root)
        date_window.grab_set()

        tk.Label(
            date_window, text="Borrowing Details", font=("Georgia", 23, "bold"),
            bg=BG, fg=DARK
        ).pack(pady=(25, 10))
        tk.Label(
            date_window, text=actual_book, font=("Georgia", 15), bg=BG, fg=SECONDARY
        ).pack(pady=(0, 20))

        form = tk.Frame(date_window, bg=BG)
        form.pack(pady=5)

        tk.Label(form, text="Planned borrow date (DD-MM-YYYY)", font=NORMAL_FONT,
                 bg=BG).grid(row=0, column=0, sticky="w", pady=12, padx=8)
        borrow_date_entry = tk.Entry(form, font=("Arial", 14), width=20, bg=LIGHT)
        borrow_date_entry.grid(row=0, column=1, pady=12, padx=8)

        tk.Label(form, text="Planned return date (DD-MM-YYYY)", font=NORMAL_FONT,
                 bg=BG).grid(row=1, column=0, sticky="w", pady=12, padx=8)
        return_date_entry = tk.Entry(form, font=("Arial", 14), width=20, bg=LIGHT)
        return_date_entry.grid(row=1, column=1, pady=12, padx=8)

        def confirm_borrow():
            borrow_date = borrow_date_entry.get().strip()
            return_date = return_date_entry.get().strip()

            if borrow_date == "" or return_date == "":
                messagebox.showwarning(
                    "Missing Dates", "Please enter both dates.", parent=date_window
                )
                return

            # Validate the exact DD-MM-YYYY format and real calendar dates.
            try:
                if (
                    len(borrow_date) != 10
                    or borrow_date[2] != "-"
                    or borrow_date[5] != "-"
                    or len(return_date) != 10
                    or return_date[2] != "-"
                    or return_date[5] != "-"
                ):
                    raise ValueError

                borrow_date_value = datetime.strptime(borrow_date, "%d-%m-%Y").date()
                return_date_value = datetime.strptime(return_date, "%d-%m-%Y").date()

                # strptime can accept some non-zero-padded values, so check exact format.
                if (
                    borrow_date_value.strftime("%d-%m-%Y") != borrow_date
                    or return_date_value.strftime("%d-%m-%Y") != return_date
                ):
                    raise ValueError

            except ValueError:
                messagebox.showerror(
                    "Invalid Date",
                    "Please enter valid calendar dates in DD-MM-YYYY format.\n"
                    "For example: 05-11-2026.",
                    parent=date_window
                )
                return

            if borrow_date_value > return_date_value:
                messagebox.showerror(
                    "Invalid Date Order",
                    "The borrowing date cannot be after the return date.",
                    parent=date_window
                )
                return

            if (return_date_value - borrow_date_value).days < 10:
                messagebox.showerror(
                    "Minimum Borrowing Period",
                    "The return date must be at least 10 days after the borrowing date.",
                    parent=date_window
                )
                return

            file = open("borrowed_books.csv", "a", newline="")
            writer = csv.writer(file)
            writer.writerow([ID, actual_book, borrow_date, return_date])
            file.close()

            query = """
            UPDATE books
            SET Quantity = Quantity - 1
            WHERE Book_Name=%s
            """
            cursor.execute(query, (actual_book,))
            mycon.commit()

            messagebox.showinfo(
                "Happy Reading!", "You successfully borrowed:\n\n" + actual_book,
                parent=date_window
            )
            date_window.destroy()

        tk.Button(
            date_window, text="Confirm Borrow", command=confirm_borrow,
            font=BUTTON_FONT, width=22, height=2, bg=GREEN, fg="white",
            relief="flat", cursor="hand2"
        ).pack(pady=22)

    selection_window(
        "Select a Book to Borrow",
        data,
        selected_book,
        lambda x: f"{x[0]}   |   {x[1]}   |   {x[2]}   |   Available: {x[3]}"
    )


