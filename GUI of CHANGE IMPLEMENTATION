def recommendation():
    query = "SELECT DISTINCT Genre FROM books WHERE Quantity > 0"
    cursor.execute(query)
    data = cursor.fetchall()
    genres = [row[0] for row in data]

    if len(genres) == 0:
        messagebox.showinfo("Recommendations", "There are no available genres currently.")
        return

    def selected_genre(genre):
        query = """
        SELECT Book_Name
        FROM books
        WHERE LOWER(Genre)=LOWER(%s)
        AND Quantity > 0
        """
        cursor.execute(query, (genre,))
        data = cursor.fetchall()

        if len(data) > 0:
            recommended_book = random.choice(data)
            messagebox.showinfo(
                "Your Recommendation", recommended_book[0] + "\n\nwould suit you!"
            )
        else:
            messagebox.showinfo(
                "No Books", "There are no books of this genre available currently."
            )

    selection_window("Choose a Genre", genres, selected_genre)


