                messagebox.showwarning(
                    "Missing Information",
                    "For a new book, please enter the author and genre.",
                    parent=window
                )
                return

            query = "INSERT INTO books VALUES(%s, %s, %s, %s)"
            cursor.execute(query, (donation, Author, Genre, 1))

        mycon.commit()

        file = open("donors.csv", "a", newline="")
        writer = csv.writer(file)
        writer.writerow([name, donation])
        file.close()

        messagebox.showinfo(
            "Thank You!", "Thanks for donating!\n\n" + donation, parent=window
        )
        window.destroy()

    tk.Button(
        window, text="Donate Book", command=donate, font=BUTTON_FONT,
        width=25, height=2, bg=GREEN, fg="white", relief="flat", cursor="hand2"
    ).pack(pady=20)


